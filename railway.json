{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "prisma generate && next build",
    "watchPatterns": [
      "prisma/**",
      "app/**",
      "components/**",
      "lib/**",
      "auth.ts",
      "middleware.ts"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "prisma db push && next start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
